const Filesystem_File_WriteSchema = `{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Filesystem_File_Write",
  "description": "Write or overwrite a file in the agent workspace",
  "type": "object",
  "properties": {
    "append": {
      "description": "If true, append to the file instead of overwriting",
      "type": "boolean",
      "additionalProperties": false,
      "default": false
    },
    "content": {
      "description": "Content to write; use base64 encoding for binary data",
      "type": "string",
      "additionalProperties": false
    },
    "encoding": {
      "type": "string",
      "additionalProperties": false,
      "enum": [
        "utf-8",
        "base64"
      ],
      "default": "utf-8"
    },
    "path": {
      "description": "Workspace-relative path; intermediate directories are created if absent",
      "type": "string",
      "additionalProperties": false,
      "examples": [
        "output/report.md"
      ]
    }
  },
  "required": [
    "path",
    "content"
  ],
  "additionalProperties": false
}`

// Filesystem_File_Write is the argument struct for the Filesystem_File_Write capability.
// Write or overwrite a file in the agent workspace
type Filesystem_File_Write struct {
	Path     string `json:"path"`             // Workspace-relative path; intermediate directories are created if absent
	Content  string `json:"content"`          // Content to write; use base64 encoding for binary data
	Append   bool   `json:"append,omitempty"` // If true, append to the file instead of overwriting
	Encoding string `json:"encoding,omitempty"`
}

// MarshalMUS serialises Filesystem_File_Write into binary MUS format.
func (a *Filesystem_File_Write) MarshalMUS() []byte {
	var b []byte
	b = mus.AppendString(b, a.Path)
	b = mus.AppendString(b, a.Content)
	if a.Append {
		b = append(b, 1)
	} else {
		b = append(b, 0)
	}
	b = mus.AppendString(b, a.Encoding)
	return b
}

// UnmarshalMUS deserialises Filesystem_File_Write from binary MUS format.
func (a *Filesystem_File_Write) UnmarshalMUS(r io.Reader) error {
	var err error
	_ = err
	if a.Path, err = mus.ReadString(r, mus.MaxPayloadBytes); err != nil {
		return fmt.Errorf("%s: %w", "path", err)
	}
	if a.Content, err = mus.ReadString(r, mus.MaxPayloadBytes); err != nil {
		return fmt.Errorf("%s: %w", "content", err)
	}
	{
		var b [1]byte
		if _, err := io.ReadFull(r, b[:]); err != nil {
			return fmt.Errorf("%s: %w", "append", err)
		}
		a.Append = b[0] != 0
	}
	if a.Encoding, err = mus.ReadString(r, mus.MaxPayloadBytes); err != nil {
		return fmt.Errorf("%s: %w", "encoding", err)
	}
	return nil
}

// Filesystem_File_Write_Result is the typed MUS result payload.
// Object with fields: path, bytes_written
type Filesystem_File_Write_Result struct {
	Path         string `json:"path"`
	BytesWritten int    `json:"bytes_written"`
}

func (a *Filesystem_File_Write_Result) MarshalMUS() []byte {
	var b []byte
	b = mus.AppendString(b, a.Path)
	b = mus.AppendVarint(b, uint64(a.BytesWritten))
	return b
}

func (a *Filesystem_File_Write_Result) UnmarshalMUS(r io.Reader) error {
	var err error
	_ = err
	if a.Path, err = mus.ReadString(r, mus.MaxPayloadBytes); err != nil {
		return fmt.Errorf("%s: %w", "path", err)
	}
	{
		v, err := mus.ReadVarint(r)
		if err != nil {
			return fmt.Errorf("%s: %w", "bytes_written", err)
		}
		a.BytesWritten = int(v)
	}
	return nil
}
