const Browser_Page_ReadSchema = `{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Browser_Page_Read",
  "description": "Fetch the readable text content of a web page, stripped of markup, scripts, and boilerplate",
  "type": "object",
  "properties": {
    "timeout": {
      "description": "Maximum seconds to wait for page load before aborting",
      "type": "integer",
      "additionalProperties": false,
      "default": 30
    },
    "url": {
      "description": "Fully-qualified URL of the page to fetch",
      "type": "string",
      "additionalProperties": false,
      "examples": [
        "https://en.wikipedia.org/wiki/Go_(programming_language)"
      ]
    },
    "wait_for": {
      "description": "Page load event to wait for before extracting content",
      "type": "string",
      "additionalProperties": false,
      "enum": [
        "load",
        "domcontentloaded",
        "networkidle"
      ],
      "default": "networkidle"
    }
  },
  "required": [
    "url"
  ],
  "additionalProperties": false
}`

// Browser_Page_Read is the argument struct for the Browser_Page_Read capability.
// Fetch the readable text content of a web page, stripped of markup, scripts, and boilerplate
type Browser_Page_Read struct {
	URL     string `json:"url"`                // Fully-qualified URL of the page to fetch
	Timeout int    `json:"timeout,omitempty"`  // Maximum seconds to wait for page load before aborting
	WaitFor string `json:"wait_for,omitempty"` // Page load event to wait for before extracting content
}

// MarshalMUS serialises Browser_Page_Read into binary MUS format.
func (a *Browser_Page_Read) MarshalMUS() []byte {
	var b []byte
	b = mus.AppendString(b, a.URL)
	b = mus.AppendVarint(b, uint64(a.Timeout))
	b = mus.AppendString(b, a.WaitFor)
	return b
}

// UnmarshalMUS deserialises Browser_Page_Read from binary MUS format.
func (a *Browser_Page_Read) UnmarshalMUS(r io.Reader) error {
	var err error
	_ = err
	if a.URL, err = mus.ReadString(r, mus.MaxPayloadBytes); err != nil {
		return fmt.Errorf("%s: %w", "url", err)
	}
	{
		v, err := mus.ReadVarint(r)
		if err != nil {
			return fmt.Errorf("%s: %w", "timeout", err)
		}
		a.Timeout = int(v)
	}
	if a.WaitFor, err = mus.ReadString(r, mus.MaxPayloadBytes); err != nil {
		return fmt.Errorf("%s: %w", "wait_for", err)
	}
	return nil
}

